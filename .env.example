# Local OpenAI-compatible runtime. No paid API key is needed for this mode.
# Start the Phi-4 Mini GGUF in the local llama.cpp server before MiroFish.
# MiroFish injects LLM_BASE_URL and its gateway token for each budgeted run.
LLM_PROVIDER=local
LLM_MODEL_NAME=phi4-mini
LLM_REPORT_MODEL_NAME=phi4-mini
LLM_MAX_OUTPUT_TOKENS=2048

# MiroFish starts a loopback gateway for each run and shares this token budget
# across graph/persona/config/report requests and OASIS subprocesses.
MIROFISH_LOCAL_MODEL_BASE_URL=http://127.0.0.1:8080/v1
MIROFISH_LOCAL_REQUEST_TIMEOUT_SECONDS=480
MIROFISH_RUN_TOKEN_LIMIT=50000
MIROFISH_RUN_COST_LIMIT_USD=0

# Existing MiroFish graph memory remains on Zep Cloud.
ZEP_API_KEY=

# Sports sources. Configure keys locally in .env; never commit them.
# Football and NBA can share API_SPORTS_KEY, or use separate keys.
API_SPORTS_KEY=
API_FOOTBALL_KEY=
API_NBA_KEY=
THE_ODDS_API_KEY=
MIROFISH_SPORTS_SNAPSHOT_DIR=
MIROFISH_SPORTS_HISTORY_DIR=
MIROFISH_SPORTS_AGENT_COUNT=16
MIROFISH_SPORTS_MAX_ROUNDS=3
MIROFISH_SPORTS_BACKTEST_MAX_GRAPHS=3
MIROFISH_PAPER_LEDGER_PATH=

# Remote OpenAI-compatible API use is opt-in only. Do not enable for local tests.
# LLM_PROVIDER=openai
# LLM_API_KEY=your_remote_api_key_here
# LLM_BASE_URL=https://your-provider.example/v1
# LLM_MODEL_NAME=your_model_id
